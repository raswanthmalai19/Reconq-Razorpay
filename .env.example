# Gemini API key for the conversational copilot and smart explanations.
# Get a free key from https://aistudio.google.com/
# Primary AI provider — powers the copilot, explanations, and anomaly summaries.
GEMINI_API_KEY=

# Anthropic API key (optional fallback).
# If Gemini is unavailable, the system falls back to Claude for explanations.
# Leave blank to skip — the reconciliation engine itself is unaffected.
ANTHROPIC_API_KEY=

# Model overrides (optional — defaults are fine for most cases)
# GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
