# Gemini API key for the conversational copilot and smart explanations.
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=

# Optional Anthropic fallback.
ANTHROPIC_API_KEY=

# Optional Groq fallback.
GROQ_API_KEY=

# Optional live Razorpay settlement sync.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional outbound recovery notification.
DISCORD_WEBHOOK_URL=

# Model overrides (optional; defaults are used when omitted).
# GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# GROQ_MODEL=llama-3.3-70b-versatile
